  id         String   @id @default(uuid()) @db.Char(36)
  employeeId Int      @map("employee_id") @db.Int
  expiresAt  DateTime @map("expires_at") @db.Timestamp(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  employee Employee @relation("AuthSession_employeeId", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Source ERD: MA_XAC_THUC
model VerificationCode {
  id             Int                 @id @default(autoincrement()) @db.Int
  recipientEmail String              @map("recipient_email") @db.VarChar(100)
  purpose        VerificationPurpose
  codeHash       String              @map("code_hash") @db.VarChar(255)
  expiresAt      DateTime            @map("expires_at") @db.Timestamp(3)
  failedAttempts Int                 @default(0) @map("failed_attempts") @db.UnsignedTinyInt
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@index([expiresAt])
  @@index([recipientEmail, purpose])
  @@map("verification_codes")
}

/// Source ERD: NHAT_KY
model AuditLog {
  id         BigInt      @id @default(autoincrement()) @db.BigInt
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
  employeeId Int?        @map("employee_id") @db.Int
  action     AuditAction
  entityType String?     @map("entity_type") @db.VarChar(30)
  entityKey  Json?       @map("entity_key") @db.Json
  details    Json?       @db.Json

  employee Employee? @relation("AuditLog_employeeId", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeId])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_logs")
}

