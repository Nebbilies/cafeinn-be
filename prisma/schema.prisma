/// Source ERD: NHAN_VIEN
model Employee {
  id           Int            @id @default(autoincrement()) @db.Int
  fullName     String         @map("full_name") @db.VarChar(100)
  email        String         @unique @db.VarChar(100)
  phone        String         @db.VarChar(15)
  username     String         @unique @db.VarChar(50)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  status       EmployeeStatus
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamp(3)

  profitReports  ProfitReport[]  @relation("ProfitReport_reviewerId")
  cashierShifts  CashierShift[]  @relation("CashierShift_employeeId")
  employeeRoles  EmployeeRole[]  @relation("EmployeeRole_employeeId")
  auditLogs      AuditLog[]      @relation("AuditLog_employeeId")
  authSessions   AuthSession[]   @relation("AuthSession_employeeId")
  refundRequests RefundRequest[] @relation("RefundRequest_reviewerId")

  @@map("employees")
}

/// Source ERD: VAI_TRO
model Role {
