  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  rolePermissions RolePermission[] @relation("RolePermission_permissionId")

  @@map("permissions")
}

/// Source ERD: NHAN_VIEN_VAI_TRO
model EmployeeRole {
  employeeId Int      @map("employee_id") @db.Int
  roleId     Int      @map("role_id") @db.Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  employee Employee @relation("EmployeeRole_employeeId", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role     Role     @relation("EmployeeRole_roleId", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

/// Source ERD: VAI_TRO_QUYEN
model RolePermission {
  roleId       Int      @map("role_id") @db.Int
  permissionId Int      @map("permission_id") @db.Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  role       Role       @relation("RolePermission_roleId", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation("RolePermission_permissionId", fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Source ERD: PHIEN_DANG_NHAP
