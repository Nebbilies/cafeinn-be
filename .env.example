NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Connection components for reference when composing DATABASE_URL.
DB_HOST=database.example.invalid
DB_PORT=3306
DB_NAME=cafeinn
DB_USER=USER
DB_PASSWORD=PASSWORD

# Runtime and Prisma read DATABASE_URL; the env loader does not expand variables.
# Keep this URL consistent with the components above. URL-encode special characters.
# Configure TLS according to your database provider before real database access.
DATABASE_URL=mysql://USER:PASSWORD@database.example.invalid:3306/cafeinn
